# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# netlify CLI local build/deploy state
/.netlify/
deploy-*.zip

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android release signing — never commit these, wherever they end up.
# Real signing happens in CI from GitHub Secrets, not a local file.
*.keystore
*.jks
keystore.properties

# Static export for the standalone Android build (scripts/build-android.mjs)
/out/
/.api-stash/
