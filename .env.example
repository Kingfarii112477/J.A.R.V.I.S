# J.A.R.V.I.S AI Operating System — environment configuration
#
# None of these are required to run the app. With nothing set, every screen
# runs in DEMO / SIMULATION mode: chat gets scripted responses, telemetry
# and diagnostics are locally simulated, and voice uses the browser's
# built-in speech APIs. Set any one AI provider below to go live for chat.
#
# Copy this file to .env.local and fill in only what you need.
# Never commit .env.local — it's already in .gitignore.

# --- AI provider (pick at most one; checked in this priority order) ---

# OpenRouter (https://openrouter.ai) — checked first.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Groq (https://groq.com) — checked second.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Any OpenAI-compatible /chat/completions endpoint — checked third.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# --- n8n workflow integration ---
# Server-only. Used by both /api/chat (as a last-resort provider, if no AI
# key above is set) and /api/n8n (a dedicated forwarding endpoint). This
# value is never sent to the browser — the client only ever calls the
# internal Next.js API routes.
N8N_WEBHOOK_URL=

# --- Voice / TTS (optional future adapters) ---
# The app already works with zero configuration via the browser's built-in
# SpeechRecognition and SpeechSynthesis APIs. These are placeholders for a
# future server-proxied provider (e.g. ElevenLabs-compatible TTS) — nothing
# reads them yet.
# ELEVENLABS_API_KEY=
