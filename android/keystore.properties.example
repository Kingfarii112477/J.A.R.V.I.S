# Copy this file to android/keystore.properties (already gitignored, same as
# every *.keystore/*.jks file — never commit the real one) to sign local
# release builds without exporting environment variables. GitHub Actions
# never reads this file; it decodes the ANDROID_KEYSTORE_BASE64 secret and
# exports ANDROID_KEYSTORE_PASSWORD/ANDROID_KEY_ALIAS/ANDROID_KEY_PASSWORD as
# env vars instead — see .github/workflows/android-release.yml and the
# Android release-signing section of the README for how to generate a
# keystore and populate both.

storePassword=your-keystore-password
keyAlias=jarvis-release
keyPassword=your-key-password
# Path is resolved relative to android/app/ (the Gradle project dir this file
# is read from) unless given as absolute.
storeFile=release.keystore
